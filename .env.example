# All optional. PRISM works with ZERO keys — DuckDuckGo is the default provider.
SEARCH_PROVIDER=duckduckgo        # duckduckgo | tavily | searxng
TAVILY_API_KEY=                   # optional: free tier, 1000 credits/month, no card needed
SEARXNG_URL=                      # optional: your self-hosted or public SearxNG instance URL
DATABASE_URL=sqlite:///data/prism.db
SIMILARITY_THRESHOLD=0.85
MAX_RESULTS_PER_QUERY=10
REQUEST_TIMEOUT=15
USER_AGENT=PRISM-ResearchBot/1.0
